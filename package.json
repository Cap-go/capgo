{
  "name": "capgo-app",
  "type": "module",
  "version": "22.2.2",
  "private": true,
  "workspaces": [
    "cli",
    "packages/*"
  ],
  "license": "GPL-3.0",
  "scripts": {
    "build:snippet": "bun scripts/snippet/build-snippet.ts",
    "check:snippet": "bun scripts/snippet/build-snippet.ts --check",
    "readreplicate:setup-source": "bash read_replicate/replicate_setup_source.sh",
    "readreplicate:prepare": "bash read_replicate/replicate_prepare.sh",
